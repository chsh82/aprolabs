# SSH keys - NEVER commit
*.pub
aprolabs_deploy*
:USERPROFILE*
**/.ssh/

# Databases
*.db
*.db.bak*
*.sqlite
*.sqlite3

# 모모의책장 교재DB에서 추출한 이미지(용량이 커서 git에 안 올림 - db처럼 서버에 수동 동기화)
momo_book_db/extracted_images/

# 학습지 자동 생성기(momo_book_db/generate, worksheet/scripts) - node_modules는 npm install로
# 서버에서 직접 설치(배포 스크립트가 pip install만 해주고 npm install은 안 해줌 - 수동 1회 설치
# 필요), generated/는 웹 화면에서 버튼으로 만드는 산출물이라 재생성 가능 - 둘 다 git에 안 올림.
momo_book_db/worksheet/node_modules/
momo_book_db/generated/

# 일반 어휘 퀴즈 적재(v2.1.29~) - 원본 ZIP, 압축 해제된 CSV, 표본 검수 CSV/manifest는
# scripts/vocab/import_vocabulary_quiz.py · sample_vocabulary_quiz_qa.py로 재생성 가능하고
# 용량도 커서 git에 안 올림. vocabulary_quiz_rnd.db 자체는 위 "Databases" 규칙(*.db)으로
# 이미 제외됨. 반대로 마이그레이션/모델/import 스크립트/테스트/검수 UI 코드는 그대로 커밋한다.
data/import/*.zip
data/import/vocabulary_master_*/
data/import/qa_sample_v*.csv
data/import/qa_sample_manifest_v*.json
data/import/import_failures_v*.json

# 초등 다유형 어휘 퀴즈(파일럿, v1~) - scripts/vocab/import_multiformat_quiz.py로
# 재생성 가능한 압축 해제 산출물/실패 리포트. 원본 ZIP은 위 *.zip 규칙으로 이미 제외됨.
data/import/vocabulary_multiformat_*/
data/import/import_multiformat_failures_*.json

# 학습지 편집 프로젝트(momo_book_db/worksheet/edit_projects/) - 사용자가 화면에서 만드는
# 편집 프로젝트 파일(문항 덮어쓰기, 업로드 이미지, 버전별 빌드/PDF)로 위 generated/와 같은
# 이유(용량 크고 화면에서 재생성 가능, 실제 자산은 서버에 수동 동기화)로 git에 안 올림.
momo_book_db/worksheet/edit_projects/

# 작업 중 남긴 QA/스크린샷 증거 폴더 - 재생성 가능한 검증 산출물, 커밋 안 함.
momo_book_db/worksheet/docs/evidence_*/
momo_book_db/worksheet/docs/_check_raw.json

# Temp files
nul
*.tmp
analyze_*_out.txt
warnings_dump_*.csv

# Old scripts (keep latest only)
resegment.py
resegment_v2.py
revert_segments.py

# Python
__pycache__/
*.pyc
venv/

# QA reports - keep baselines, exclude intermediate reports
golden_tests/qa_report_*.json
!golden_tests/qa_baseline_*.json

# Environment variables
.env
.env.local

# Uploads directory
uploads/

# Backup files
backup_*.json
aprolabs.db.bak_*

# Internal reports (not for repo)
golden_tests/resegment_report.json
golden_tests/stem_bogi_before.json

# 문해력 DB 원본 덤프/API 응답 (용량 크고 재수집 가능 - .gitkeep만 유지, data/literacy.db는 이미 *.db로 무시됨)
raw/*
!raw/.gitkeep

# 교재 어휘 적재 시 생성되는 매칭 실패 목록 - 재생성 가능, 커밋 안 함
data/literacy/unmatched.csv

# 퀴즈 생성 검수용 엑셀 - 재생성 가능, 커밋 안 함
data/literacy/quiz_review_*.xlsx
