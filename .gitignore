# SSH keys - NEVER commit
*.pub
aprolabs_deploy*
:USERPROFILE*
**/.ssh/

# Databases
*.db
*.db.bak*
*.sqlite
*.sqlite3

# 모모의책장 교재DB에서 추출한 이미지(용량이 커서 git에 안 올림 - db처럼 서버에 수동 동기화)
momo_book_db/extracted_images/

# Temp files
nul
*.tmp
analyze_*_out.txt
warnings_dump_*.csv

# Old scripts (keep latest only)
resegment.py
resegment_v2.py
revert_segments.py

# Python
__pycache__/
*.pyc
venv/

# QA reports - keep baselines, exclude intermediate reports
golden_tests/qa_report_*.json
!golden_tests/qa_baseline_*.json

# Environment variables
.env
.env.local

# Uploads directory
uploads/

# Backup files
backup_*.json
aprolabs.db.bak_*

# Internal reports (not for repo)
golden_tests/resegment_report.json
golden_tests/stem_bogi_before.json

# 문해력 DB 원본 덤프/API 응답 (용량 크고 재수집 가능 - .gitkeep만 유지, data/literacy.db는 이미 *.db로 무시됨)
raw/*
!raw/.gitkeep
